---
import ThemeToggle from './ThemeToggle.astro';
import { SITE, withBase } from '../lib/site';

const rawPath = Astro.url.pathname;
const path = rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
const home = withBase('');
const isHome = path === home;
const isTags = path.startsWith(withBase('tags/'));
const isAbout = path.startsWith(withBase('about'));
---

<header class="site-header">
  <div class="header-inner container">
    <a class="brand" href={home} aria-label={`${SITE.title} 首页`}>
      <span class="brand-seal" aria-hidden="true">白</span>
      <span class="brand-text">
        <strong>{SITE.title}</strong>
        <small>{SITE.description}</small>
      </span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      <a href={home} aria-current={isHome ? 'page' : undefined}>文章</a>
      <a href={withBase('tags/')} aria-current={isTags ? 'page' : undefined}>标签</a>
      <a href={withBase('about/')} aria-current={isAbout ? 'page' : undefined}>关于</a>
      <a class="nav-rss" href={withBase('rss.xml')} title="RSS 订阅">RSS</a>
      <ThemeToggle />
    </nav>
  </div>
</header>
